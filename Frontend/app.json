{
  "expo": {
    "name": "Estoria",
    "slug": "Estoria",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/bastaIcon2.png",
    "scheme": "estoria",
    "userInterfaceStyle": "automatic",
    "extra": {
      "tmdbApiKey": "f855e6aaf1e6cb74c0905c5b2d67c145",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6209f54c-fabd-493e-8f69-6a4f3a3bd396"
      }
    },
    "ios": {
      "icon": "./assets/images/bastaIcon2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bastaIcon2.png",
        "monochromeImage": "./assets/images/bastaIcon2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kencantcode.Estoria"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/bastaIcon2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/bastaIcon2.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/bastaIcon2.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Estoria accesses your photos so you can choose a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      "expo-image",
      "expo-screen-orientation",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "bastasecret"
  }
}
