{
  "expo": {
    "name": "Estoria",
    "slug": "Estoria",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/bastaIcon2.png",
    "scheme": "estoria",
    "userInterfaceStyle": "automatic",
    "extra": {
      "tmdbApiKey": "f855e6aaf1e6cb74c0905c5b2d67c145",
      "router": {},
      "eas": {
        "projectId": "c9e0ad40-a1a5-479d-969f-107279af1e32"
      }
    },
    "ios": {
      "icon": "./assets/images/bastaIcon2.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/bastaIcon2.png",
        "monochromeImage": "./assets/images/bastaIcon2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.kencantcode.Estoria"
    },
    "web": {
